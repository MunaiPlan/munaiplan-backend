# Copy values into a private local env file. Never use these placeholders as credentials.
APP_ENV=local
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=munaiplan_local
DB_USERNAME=munaiplan_local
DB_PASSWORD=replace-with-generated-secret
USER_ACCESS_TOKEN_SECRET=replace-with-generated-secret
USER_REFRESH_TOKEN_SECRET=replace-with-different-generated-secret
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_MINUTES=43200
PASSWORD_SALT=replace-with-generated-secret
PREDICTION_SERVICE_URL=http://127.0.0.1:8001/predict

# Only needed for the explicit dev-seed command (APP_ENV must be local).
DEV_SEED_EMAIL=developer@example.invalid
DEV_SEED_PASSWORD=replace-with-generated-local-password
DEV_SEED_ORGANIZATION=Munai Local
